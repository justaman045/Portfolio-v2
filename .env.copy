# Contact form — see app/api/contact/route.ts
# Apps Script web app whose doPost appends to the 'Contact' sheet of a spreadsheet
# (rows: Timestamp, Name, Email, Message, Social). Requires a Web app deployment
# with Execute as: Me and access: Anyone.
CONTACT_SUBMIT_URL=your_script_google_com_macros_exec_url

# Google Analytics (required — app/layout.tsx throws without it)
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=your_google_verification_token

# Discord invite — used by app/(root)/community/route.ts
NEXT_PUBLIC_DISCORD_LINK=your_discord_invite_link

# Resume Link
NEXT_PUBLIC_RESUME_LINK=your_resume_link
